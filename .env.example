# ── Next.js (.env.local) ─────────────────────────────────────────────
NEXT_PUBLIC_CONVEX_URL=            # written by `npx convex dev`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # Clerk dashboard → API keys
CLERK_SECRET_KEY=

# ── Convex (set with `npx convex env set NAME value`, never in this file) ──
# CLERK_JWT_ISSUER_DOMAIN   Clerk → JWT templates → "convex" → Issuer URL
# LENDLOOP_N8N_SECRET       shared HMAC secret, same value as n8n's (openssl rand -hex 32)
# N8N_LOAN_WEBHOOK_URL      e.g. http://localhost:5678/webhook/lendloop-loan-events

# ── n8n (.env next to docker-compose.yml) ───────────────────────────
LENDLOOP_N8N_SECRET=               # same value as in Convex
LENDLOOP_CONVEX_SITE_URL=          # your Convex HTTP actions URL, e.g. https://<name>.convex.site
N8N_PUBLIC_URL=http://localhost:5678/
