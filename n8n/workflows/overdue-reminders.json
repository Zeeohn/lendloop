{
  "id": "LendLoopOverdue0001",
  "name": "LendLoop – Overdue reminders",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "LendLoopErrHandler01",
    "saveDataErrorExecution": "all"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "name": "Every day 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {},
      "name": "Run now (manual)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        180
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Signs an outgoing request to Convex: HMAC-SHA256 over `${ts}.${METHOD} ${path}.${body}`.\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_N8N_SECRET;\nif (!secret || secret.length < 32) throw new Error('LENDLOOP_N8N_SECRET is not set (min 32 chars)');\nfunction signed(method, path, body) {\n  const ts = Math.floor(Date.now() / 1000).toString();\n  const sig = crypto.createHmac('sha256', secret).update(`${ts}.${method} ${path}.${body}`).digest('hex');\n  return { ts, sig };\n}\n\nreturn [{ json: signed('GET', '/n8n/overdue-loans', '') }];"
      },
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/overdue-loans",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "name": "Fetch overdue loans",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// One item per overdue loan. Only the borrower's name/email and the tool leave Convex.\nconst loans = $input.first().json.loans || [];\nreturn loans.map(l => ({ json: l }));"
      },
      "name": "One item per loan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Mock reminder (swap for Send Email/Slack). Builds the signed write-back for Convex.\n\n// Signs an outgoing request to Convex: HMAC-SHA256 over `${ts}.${METHOD} ${path}.${body}`.\nconst crypto = require('crypto');\nconst secret = $env.LENDLOOP_N8N_SECRET;\nif (!secret || secret.length < 32) throw new Error('LENDLOOP_N8N_SECRET is not set (min 32 chars)');\nfunction signed(method, path, body) {\n  const ts = Math.floor(Date.now() / 1000).toString();\n  const sig = crypto.createHmac('sha256', secret).update(`${ts}.${method} ${path}.${body}`).digest('hex');\n  return { ts, sig };\n}\n\nreturn $input.all().map(({ json: l }) => {\n  console.log(`[LendLoop reminder] key=${l.reminderKey} to=${l.borrower.email} :: \"${l.toolName}\" was due ${l.endDate} (${l.daysOverdue} day(s) overdue)`);\n  const body = JSON.stringify({ reminderKey: l.reminderKey, loanId: l.loanId, status: 'sent', detail: 'reminder sent (mock)' });\n  return { json: { ...signed('POST', '/n8n/reminder-result', body), body } };\n});"
      },
      "name": "Send reminder (mock) + sign write-back",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.LENDLOOP_CONVEX_SITE_URL }}/n8n/reminder-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-lendloop-timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "x-lendloop-signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}"
      },
      "name": "Write status back to Convex",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every day 09:00": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "One item per loan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per loan": {
      "main": [
        [
          {
            "node": "Send reminder (mock) + sign write-back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reminder (mock) + sign write-back": {
      "main": [
        [
          {
            "node": "Write status back to Convex",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now (manual)": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}